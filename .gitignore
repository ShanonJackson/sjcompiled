node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log
bun.lockb
# SWC's WASM-plugin runtime cache (auto-managed via
# `experimental.cacheRoot`). Files are regenerated when the WASM
# changes.
.swc/
# Phase D parity-harness browserslist snapshot cache. Recomputed at
# `parity-harness/babel-plugin/engines.ts` module load via
# `precomputeBrowserslistDefault` against the vendored AFM
# .browserslistrc. Regenerable; checking in would tie the snapshot
# to a specific caniuse-db revision and make snapshot updates a
# reviewable diff (which is the exact opposite of what we want).
.parity-harness-cache/
# `bun parity-harness/fixtures-triage.mjs` writes here; regenerable
# (the analogous JSON-corpus report at
# `parity-harness/babel-plugin/triage-report.json` is intentionally
# checked in for the §6.5 baseline lock).
parity-harness/fixtures-triage-report.json
parity-harness/strip-runtime/_scratch/
# §1.8 synth corpus is regenerable from the deterministic seed in
# synthesize-fixtures.mjs; checking in 1000 small fixtures bloats the
# repo and obscures real fixture diffs. Run
# `bun parity-harness/strip-runtime/synthesize-fixtures.mjs` to
# rehydrate before `bun test parity-harness/strip-runtime/harness.test.ts`.
parity-harness/strip-runtime/fixtures/synthesized/
# §2.0 babel-plugin fixtures are regenerable from the source tests via
# extract-fixtures.mjs. The harness self-bootstraps if absent.
parity-harness/babel-plugin/fixtures/
# Phase 3 §3.2 hash corpus is regenerable from the deterministic seed
# in parity-harness/hash/oracle.mjs (mulberry32 seed=1). Run
# `bun parity-harness/hash/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test hash_parity`.
crates/babel-plugin/tests/hash_corpus.json
# Phase 4 §4.1 transform-css corpus is regenerable from the JS oracle
# crossing 30 fixtures × 4 opts. Run
# `bun parity-harness/transform-css/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test transform_css_integration`.
crates/babel-plugin/tests/transform_css_corpus.json
# Phase 4 §4.2 compat-generator corpus is regenerable from the JS oracle
# walking parity-harness/compat-generator/fixtures.json. Run
# `bun parity-harness/compat-generator/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test compat_generator_integration`.
crates/babel-plugin/tests/compat_generator_corpus.json
# Phase 5 §5.0a/b compat-scope corpus — regenerable from the JS oracle
# walking parity-harness/compat-scope/fixtures.json against pinned
# @babel/traverse@7.29.0. Run
# `bun parity-harness/compat-scope/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test compat_scope_integration`.
crates/babel-plugin/tests/compat_scope_corpus.json
# Phase 5 §5.0c compat-evaluation corpus — regenerable from the JS oracle
# walking parity-harness/compat-evaluation/fixtures.json against pinned
# @babel/traverse@7.29.0. Run
# `bun parity-harness/compat-evaluation/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test compat_evaluation_integration`.
crates/babel-plugin/tests/compat_evaluation_corpus.json
# Phase 5 §5.4a resolver-matrix corpus — regenerable from the JS oracle
# walking parity-harness/resolver-matrix/fixtures.json + fixtures-source/
# against pinned enhanced-resolve@5.18.3 and resolve@1.22.12. Run
# `bun parity-harness/resolver-matrix/oracle.mjs` to rehydrate before
# `cargo test -p babel-plugin --test resolver_matrix_integration`.
crates/babel-plugin/tests/resolver_matrix_corpus.json
