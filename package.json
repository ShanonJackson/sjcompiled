{
  "name": "sjcompiled",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/tsconfig.json",
    "test": "bun test smoke/",
    "smoke": "bun test smoke/",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/preset-react": "^7.28.5",
    "@sjcompiled/babel-plugin": "workspace:*",
    "@sjcompiled/babel-plugin-strip-runtime": "workspace:*",
    "@sjcompiled/css": "workspace:*",
    "@sjcompiled/utils": "workspace:*",
    "@swc/core": "1.15.8",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.1.13",
    "@types/node": "^22.7.0",
    "caniuse-lite": "1.0.30001690",
    "prettier": "2.8.8",
    "typescript": "^5.6.3"
  },
  "//": "Parity-contract pins. See REFERENCE_LOCK_FILE/yarn.lock and crates/PARITY_VERSIONS.md. Every value below is the EXACT version the Rust ports target. Without these overrides, bun's caret ranges silently float past the pins (we observed postcss-discard-duplicates@6.0.0 -> 6.0.3, postcss@8.4.31 -> 8.5.13, postcss-selector-parser@6.0.13 -> 6.1.2, autoprefixer@10.4.14 -> 10.5.0). Do NOT bump any value here without a hash-rotation plan.",
  "overrides": {
    "postcss": "8.4.31",
    "postcss-nested": "5.0.6",
    "postcss-normalize-whitespace": "5.1.1",
    "postcss-discard-comments": "5.1.2",
    "postcss-normalize-string": "5.1.0",
    "postcss-normalize-positions": "5.1.1",
    "postcss-normalize-timing-functions": "5.1.0",
    "postcss-normalize-url": "5.1.0",
    "postcss-selector-parser": "6.0.13",
    "postcss-values-parser": "6.0.2",
    "postcss-discard-duplicates": "6.0.0",
    "autoprefixer": "10.4.14",
    "caniuse-lite": "1.0.30001690",
    "electron-to-chromium": "1.5.76",
    "node-releases": "2.0.19",
    "@swc/core": "1.15.8",
    "prettier": "2.8.8",
    "cssnano-preset-default": {
      ".": "5.2.14",
      "postcss-discard-duplicates": "5.1.0"
    }
  }
}
